---
import astroLogo from '../assets/astro.svg';
---

<div class="font-sans h-screen bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center">
	<div class="text-center p-8 bg-white rounded-xl shadow-xl max-w-md">
		<h1 class="text-5xl font-bold bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent mb-8">
			Welcome to Astro Tailwind
		</h1>
		<div class="flex gap-4 justify-center">
			<a class="flex items-center py-3 px-5 text-white bg-gradient-to-r from-blue-600 to-purple-500 shadow-md rounded-lg hover:text-gray-200 hover:shadow-none transition-colors" href="https://docs.astro.build">Astro Docs</a>
			<a class="flex items-center py-3 px-5 text-white bg-gradient-to-r from-cyan-500 to-teal-500 shadow-md rounded-lg hover:text-gray-200 hover:shadow-none transition-colors" href="https://tailwindcss.com/docs">
				Tailwind Docs
			</a>
		</div>
	</div>
</div>